# Copy this file to `.env` and fill in your key.
#
# Any OpenAI-compatible chat API works with LLM_PROVIDER=openai_compatible:
# NVIDIA build (default), OpenAI, OpenRouter, Groq, Together, local Ollama, ...
# To switch providers, change these four lines; no code changes needed.

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
# Copy the exact model id from the code sample on build.nvidia.com/z-ai/glm-5-3
LLM_MODEL=z-ai/glm-5.3
# If the provider returns a 400 error about response_format, set this to false.
LLM_JSON_MODE=true

# Examples of other providers:
# LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=z-ai/glm-4.6
# LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1   (Ollama, key can be anything)

# Non-OpenAI-style providers (via Pydantic AI): set the provider name and its own key variable.
# LLM_PROVIDER=anthropic   LLM_MODEL=claude-sonnet-5-5   ANTHROPIC_API_KEY=...
#   (also: pip install "pydantic-ai-slim[anthropic]")

# Optional backups tried in order if the main model errors (e.g. free tier rate limit).
# Each needs its provider's usual key variable, e.g. OPENAI_API_KEY.
# LLM_FALLBACK_MODELS=openai:gpt-5.2

# Hosting: set a password whenever other people can reach the app. Leave empty on your own computer.
APP_PASSWORD=
